* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: Arial, sans-serif;
}

html {
    scroll-behavior: smooth;
}

body {
    background: #0f172a;
    color: white;
}

/* Navbar */
.navbar {
    position: sticky;
    top: 0;
    z-index: 1000;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px 8%;
    background: rgba(255,255,255,0.08);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(255,255,255,0.1);
}

.logo {
    font-size: 28px;
    font-weight: bold;
}

.nav-links {
    display: flex;
    list-style: none;
    gap: 30px;
}

.nav-links a {
    color: white;
    text-decoration: none;
    transition: 0.3s;
}

.nav-links a:hover {
    color: gold;
}

.nav-icons {
    display: flex;
    gap: 20px;
    font-size: 20px;
}

.nav-icons a {
    color: white;
}

/* Hero Section */
.hero {
    height: 90vh;
    display: flex;
    justify-content: center;
    align-items: center;
    text-align: center;
    padding: 0 20px;
    background: linear-gradient(135deg, #1e293b, #0f172a);
}

.hero-content h1 {
    font-size: 56px;
    max-width: 900px;
    margin-bottom: 20px;
}

.hero-content p {
    font-size: 20px;
    margin-bottom: 30px;
}

.btn {
    display: inline-block;
    padding: 14px 30px;
    background: gold;
    color: black;
    font-weight: bold;
    border-radius: 12px;
    text-decoration: none;
    transition: 0.3s;
}

.btn:hover {
    transform: translateY(-3px);
}

/* Featured Products */
.featured {
    padding: 80px 8%;
}

.featured h2 {
    text-align: center;
    font-size: 40px;
    margin-bottom: 50px;
}

.product-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 30px;
}

.product-card {
    background: rgba(255,255,255,0.08);
    padding: 20px;
    border-radius: 20px;
    text-align: center;
    backdrop-filter: blur(10px);
    transition: 0.3s;
}

.product-card:hover {
    transform: translateY(-10px);
}

.product-card img {
    width: 100%;
    height: 250px;
    object-fit: cover;
    border-radius: 14px;
}

.product-card h3 {
    margin: 20px 0 10px;
}

.product-card p {
    font-size: 20px;
    color: gold;
}

.product-card button {
    margin-top: 15px;
    padding: 12px 20px;
    border: none;
    background: gold;
    border-radius: 12px;
    font-weight: bold;
    cursor: pointer;
}

/* Reviews */
.reviews {
    padding: 80px 8%;
    text-align: center;
}

.reviews h2 {
    font-size: 40px;
    margin-bottom: 30px;
}

.review-box {
    background: rgba(255,255,255,0.08);
    padding: 25px;
    margin: 20px auto;
    max-width: 600px;
    border-radius: 18px;
}

/* About */
.about {
    padding: 80px 8%;
    text-align: center;
}

.about h2 {
    font-size: 40px;
    margin-bottom: 20px;
}

/* Footer */
footer {
    padding: 25px;
    text-align: center;
    background: #020617;
}

/* Responsive */
@media (max-width: 768px) {
    .hero-content h1 {
        font-size: 34px;
    }

    .nav-links {
        display: none;
    }

    .featured h2,
    .reviews h2,
    .about h2 {
        font-size: 30px;
    }
}
